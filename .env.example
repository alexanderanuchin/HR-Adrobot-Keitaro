# Safe template. Copy to .env and provide local secrets; never commit .env.
COMPOSE_PROJECT_NAME=adrobot
APP_ENV=development
POSTGRES_DB=adrobot
POSTGRES_USER=adrobot
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
DJANGO_SECRET_KEY=replace-with-random-long-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INTERNAL_API_KEY=replace-with-random-internal-secret
FASTAPI_INTERNAL_URL=http://fastapi:8000
KEITARO_BASE_URL=https://tlgk.host
KEITARO_API_KEY=
KEITARO_HTTP_TIMEOUT=15
TELEGRAM_BOT_TOKEN=
LOG_LEVEL=INFO
